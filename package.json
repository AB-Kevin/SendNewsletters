{
  "name": "sendnewsletters",
  "version": "0.1.0",
  "description": "SendNewsletters - keep the newsletter mailing list, email the newsletter as a PDF, and get the addresses and counts for mailed copies",
  "main": "main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "release": "electron-builder --win --publish always"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.sendnewsletters.app",
    "productName": "SendNewsletters",
    "files": [
      "main.js",
      "preload.js",
      "db/**/*",
      "lib/**/*",
      "renderer/**/*",
      "templates/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "AB-Kevin",
      "repo": "SendNewsletters",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "nodemailer": "^10.0.15",
    "papaparse": "^5.4.1",
    "xlsx": "^0.18.5"
  }
}
